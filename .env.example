# Provider: groq (free) | openai (paid) | ollama (local)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Required when LLM_PROVIDER is groq or openai
# Groq: free key from console.groq.com -> API Keys
LLM_API_KEY=your_api_key_here

GROQ_BASE_URL=https://api.groq.com/openai/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1   # for LLM_PROVIDER=ollama

# Embeddings (local, free) - chromadb ONNX backend
EMBEDDING_PROVIDER=chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_MIN_SCORE=0.3

CHROMA_PATH=./.chroma
KNOWLEDGE_DIR=./knowledge
RETRIEVAL_TOP_K=4

MAX_TOOL_ITERATIONS=5

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO
